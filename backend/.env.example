# 后端配置示例
# 使用方法：
# 1. 复制本文件为 backend/.env
# 2. 把下面的 your_xxx 替换成自己的真实密钥
# 3. backend/.env 不要提交到 Git，也不要发到公开群里

# 必填：阿里云百炼 DashScope API Key
# 用于大模型问答、图片理解、Embedding 向量化和 Rerank 重排。
DASHSCOPE_API_KEY=your_dashscope_api_key

# 可选：Tavily API Key
# 用于联网搜索。不配置时，联网搜索功能不可用，但本地知识库问答仍可运行。
TAVILY_API_KEY=your_tavily_api_key

# 大模型兼容接口地址
# 当前示例使用 DashScope OpenAI-compatible 接口。
# 如果改成本地 Ollama，可以写成：http://localhost:11434/v1
OLLAMA_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 默认调用的模型名称
# 如果使用 DashScope，请改成账号可调用的模型名。
# 如果使用 Ollama，请改成已经配置到本地的模型名，例如 qwen2.5:3b。
OLLAMA_MODEL=qwen-max

# Chroma 向量库目录
# 后端 RAG 检索会从这里读取本地知识库向量数据。
CHROMA_PERSIST_DIR=./chroma_db

# SQLite 数据库路径
# 用于保存用户、会话和聊天记录。
DB_PATH=./orange_agent.db

# RAG 检索参数：初始召回数量
RAG_SEARCH_K=8

# RAG 检索参数：Rerank 后保留的结果数量
RAG_RERANK_TOP_K=4

# Rerank 最低分数阈值，低于该值的结果会被过滤
RERANK_MIN_SCORE=0.1

# CRAG 判断阈值：高于该分数时认为本地知识库结果较可靠
CRAG_GOOD_SCORE=0.65

# CRAG 判断阈值：低于该分数时可能触发联网搜索或补充检索
CRAG_LOW_SCORE=0.35
